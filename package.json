{
  "name": "portal-jogos-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo para o Portal de Jogos HTML5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node node_modules/prisma/build/index.js generate --schema=./apps/api/prisma/schema.prisma",
    "dev:api": "npm run dev --workspace=@portal-jogos/api",
    "dev:web": "npm run dev --workspace=@portal-jogos/web",
    "dev:admin": "npm run dev --workspace=@portal-jogos/admin",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:admin\"",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace=@portal-jogos/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=@portal-jogos/api",
    "prisma:studio": "npm run prisma:studio --workspace=@portal-jogos/api",
    "check:game": "node scripts/check-game.js",
    "check:games": "node scripts/check-game.js --all"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^5.3.3"
  }
}
